# 公共交通オープンデータセンター (ODPT) API のコンシューマキー
# https://developer.odpt.org/ で取得してください
ODPT_CONSUMER_KEY=your_odpt_consumer_key_here

# Google Maps JavaScript API キー
# https://console.cloud.google.com/google/maps-apis で取得してください
# HTTP リファラー制限を設定することを推奨します
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Map ID (Advanced Marker を使うために必須)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Google Routes API キー (任意・サーバー側でのみ使用)
# 地図で選んだバスの経路を道路に沿って描くために使う。未設定の場合は
# 停留所を結んだおおよその経路 (点線) で表示する。
# ブラウザ用のキーとは別に発行し、「API の制限」で Routes API のみに絞ること
# (サーバーから呼び出すので HTTP リファラー制限は付けない)
#GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here

# ハチ公バス (春の小川ルート) の専用車両の車番 (任意)
# ODPT に系統情報が無いため、ここに列挙した車番のバスを
# 「ハチ公バス 春の小川ルート」として表示する
# カンマ区切りの 5 桁半角数字
#HACHIKO_BUS_VEHICLE_NUMBERS=12345,23456
