# 公共交通オープンデータセンター (ODPT) API のコンシューマキー
# https://developer.odpt.org/ で取得してください
ODPT_CONSUMER_KEY=your_odpt_consumer_key_here

# Google Maps JavaScript API キー
# https://console.cloud.google.com/google/maps-apis で取得してください
# HTTP リファラー制限を設定することを推奨します
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Map ID (Advanced Marker を使うために必須)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
